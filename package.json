    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/node": "^26.1.1",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "xmlrpc": "^1.3.2"
  },
  "type": "module"
}
